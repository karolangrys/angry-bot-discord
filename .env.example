# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Register slash commands for this guild only (instant updates while developing).
# LEAVE THIS EMPTY IN PRODUCTION, otherwise commands are never registered globally.
TEST_GUILD_ID=your_test_guild_id_here

# Comma-separated user IDs allowed to run process-wide commands such as /status.
# When empty, the application owner reported by Discord is used instead.
OWNER_IDS=

# Database Configuration
DATABASE_URL=sqlite.db

# Directory for winston log files.
LOG_DIR=logs

# Environment
NODE_ENV=development

# --- Only needed on the VPS, read by docker-compose.yml ---
# Your GitHub owner in lowercase (the GHCR namespace of the image).
# IMAGE_OWNER=your-github-username
# Image tag to run; the CI deployment sets this to the exact commit.
# IMAGE_TAG=latest
